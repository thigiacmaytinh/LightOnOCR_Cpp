<Window x:Class="LightOnOCR_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisCom Solution OCR" Height="750" Width="1150" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="PrimaryBtnBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="ActionBtnBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusBarBgBrush" Color="#E5E7EB"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="SpinningIconStyle" TargetType="TextBlock">
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanDelete}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Primary Button Style (Blue) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover State -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <!-- Darker Blue -->
                            </Trigger>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF"/>
                                <!-- Solid Grey Background -->
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                                <!-- Light Grey Text -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Green) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBtnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover State -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                                <!-- Darker Green -->
                            </Trigger>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF"/>
                                <!-- Solid Grey Background -->
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                                <!-- Light Grey Text -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- APP HEADER / NAV BAR -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="VisCom Solution OCR" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="ThemeToggleBtn" Content="🌙 Dark Mode" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="15,8" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="ToggleTheme_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15,15,15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: File Queue -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="16" Margin="0,0,15,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Queue Header with Clear All Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Document Queue" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ClearAllBtn" Content="🗑️ Clear All" HorizontalAlignment="Right" Padding="10,5" Background="Transparent" Foreground="#EF4444" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" Click="ClearAll_Click" Visibility="{Binding ElementName=FileQueueList, Path=HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Button Grid.Row="1" x:Name="SelectFilesBtn" Content="+ Select Images / PDFs" Height="45" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Click="SelectFiles_Click"/>

                    <!-- Sortable ListBox with Transparent Background for hit testing -->
                    <ListBox x:Name="FileQueueList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,15" AllowDrop="True" PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" Drop="List_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBgBrush}" CornerRadius="10" Padding="12" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusColor}" Margin="0,0,15,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="💾" Width="28" Height="28" Background="#10B981" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Tag="{Binding}" Click="SaveSingleFile_Click" Cursor="Hand" Visibility="{Binding CanSave, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Width="28" Height="28" BorderThickness="0" Tag="{Binding}" Click="RemoveFile_Click" Cursor="Hand" IsEnabled="{Binding CanDelete}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <ContentControl>
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <TextBlock Text="✕" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <TextBlock Text="⭮" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SpinningIconStyle}"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="StartBtn" Content="START PROCESSING" Height="50" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Click="StartOcr_Click" IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- Right Panel: OCR Results -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBgBrush}" CornerRadius="16" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Live Markdown Output" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <TextBox x:Name="OutputTextBox" Grid.Row="1" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" Padding="15">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SaveFilesBtn" Grid.Column="0" Grid.ColumnSpan="3" Content="💾 Save File" Height="45" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="SaveFiles_Click" IsEnabled="False"/>

                        <Button x:Name="CombineFilesBtn" Grid.Column="2" Content="📑 Combine &amp; Save (.docx)" Height="45" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="CombineFiles_Click" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 🚀 FULL SCREEN LOADING OVERLAY 🚀 -->
        <Border x:Name="LoadingOverlay" Grid.Row="1" Grid.RowSpan="2" 
                Background="{DynamicResource PanelBgBrush}" Opacity="0.95" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Animated Spinner -->
                <!-- Smooth Geometric Spinner -->
                <Path Width="60" Height="60" Margin="0,0,0,25" HorizontalAlignment="Center"
                      Stroke="{DynamicResource PrimaryBtnBrush}" StrokeThickness="6" 
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5, 0.5">

                    <!-- This defines an arc, creating a 3/4 circle ring -->
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="30,3" IsClosed="False">
                                <ArcSegment Size="27,27" IsLargeArc="True" SweepDirection="Clockwise" Point="3,30"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>

                    <!-- The perfectly centered rotation animation -->
                    <Path.RenderTransform>
                        <RotateTransform x:Name="OverlaySpinner" Angle="0"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="OverlaySpinner" 
                                                     Storyboard.TargetProperty="Angle" 
                                                     From="0" To="360" Duration="0:0:1" 
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>

                <TextBlock Text="Warming up the AI Engine..." 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

                <TextBlock Text="This may take a few seconds on the first launch." 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock x:Name="StatusIcon" Text="ℹ️" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="StatusText" Text="Initializing..." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
