<Window x:Class="LightOnOCR_UI.SuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Success" Height="280" Width="400" 
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">

    <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="16" 
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="25" ShadowDepth="5"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Colorful Icon and Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">

                <!-- Circular Green Background with Animation -->
                <Border x:Name="IconBadge" Width="65" Height="65" CornerRadius="35" Background="#D1FAE5" Margin="0,0,0,15"
                        RenderTransformOrigin="0.5, 0.5">

                    <!-- We use ScaleTransform to make it "pop" in -->
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0" ScaleY="0"/>
                    </Border.RenderTransform>

                    <!-- The Animation Triggers -->
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- 1. The Bounce/Pop Effect for Scale X -->
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconBadge" 
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                   Duration="0:0:0.5">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0"/>
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1.2" KeySpline="0.25,1,0.5,1"/>
                                        <!-- Overshoot -->
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" KeySpline="0.25,1,0.5,1"/>
                                        <!-- Settle -->
                                    </DoubleAnimationUsingKeyFrames>

                                    <!-- 2. The Bounce/Pop Effect for Scale Y -->
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconBadge" 
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                   Duration="0:0:0.5">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0"/>
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1.2" KeySpline="0.25,1,0.5,1"/>
                                        <!-- Overshoot -->
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" KeySpline="0.25,1,0.5,1"/>
                                        <!-- Settle -->
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <TextBlock Text="🎉" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
                </Border>

                <TextBlock Text="Saved Successfully!" FontSize="22" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Message with more breathing room -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Text="Your file has been saved." 
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" 
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0"/>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Close Button (Grey) -->
                <Button x:Name="CloseBtn" Grid.Column="0" Content="Close" Height="42" 
                        Foreground="#4B5563" FontSize="14" FontWeight="Bold" 
                        Cursor="Hand" Click="CloseBtn_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#F3F4F6" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB"/>
                                    <!-- Darker Grey on hover -->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#D1D5DB"/>
                                    <!-- Even darker when clicked -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Open File Button (Green) -->
                <Button x:Name="OpenFileBtn" Grid.Column="2" Content="Open File" Height="42" 
                        Foreground="White" FontSize="14" FontWeight="Bold" 
                        Cursor="Hand" Click="OpenFileBtn_Click" Visibility="Collapsed" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#10B981" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#059669"/>
                                    <!-- Darker Green on hover -->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#047857"/>
                                    <!-- Even darker when clicked -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>